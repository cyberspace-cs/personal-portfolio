# ===== Hermes Agent 配置（拷成 hermes.env，挂载到 /root/.hermes/.env） =====
# 重要：API_SERVER_KEY 必须与 coach 的 .env 里的 HERMES_KEY 完全一致。

# —— API Server 开关（必须） ——
API_SERVER_ENABLED=true
API_SERVER_KEY=请改成一段强随机串-例如-openssl-rand-hex-32
# 容器内 bind 0.0.0.0，仅 Docker 内网可达；不要映射到宿主机端口
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
# 仅后端内网调用，无需浏览器 CORS，留空即可
# API_SERVER_CORS_ORIGINS=

# —— 上游模型提供商（任选其一，填入对应 KEY） ——
# 方案A：OpenRouter（推荐，一个 Key 用 300+ 模型，含 DeepSeek/Claude/Qwen…）
OPENROUTER_API_KEY=sk-or-xxxxxxxx
# 方案B：DeepSeek 直连
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# 方案C：OpenAI 直连
# OPENAI_API_KEY=sk-xxxxxxxx
# 方案D：Nous Portal（先 hermes setup --portal 做 OAuth，可不填 Key）
