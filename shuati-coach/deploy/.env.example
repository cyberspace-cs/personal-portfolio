# ===== 教练后端环境变量（拷成 .env） =====
# 域名需已完成 ICP 备案

# 结构化 AI 讲题/变式/报告用的模型（可选；不填则走内置降级文案，前端仍可用）
API_BASE=https://api.openai.com/v1
API_KEY=
MODEL=gpt-3.5-turbo

# 把自由问答接到 Hermes Agent（内网代理，绝不公网暴露）
# 必须和 hermes.env 里的 API_SERVER_KEY 完全一致
HERMES_BASE=http://hermes:8642/v1
HERMES_KEY=请改成一段强随机串-与-hermes.env-的-API_SERVER_KEY-一致
HERMES_MODEL=hermes-agent

# 静态文件根目录（容器内固定为 /app）
STATIC_DIR=/app
