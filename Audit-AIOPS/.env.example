# ===== 审计智能一体化运维平台 · 环境变量示例 =====
# 复制为 .env 并填入真实值；未配置时使用 Mock 基座，平台仍可完整演示编排/检索链路。

# ---- 基座模型（可插拔：mock / hunyuan / qwen）----
# mock：离线演示，无外部依赖
# hunyuan：腾讯混元（OpenAI 兼容接口）
# qwen：阿里通义千问（OpenAI 兼容接口）
LLM_PROVIDER=mock

# 腾讯混元
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_MODEL=hunyuan-turbo

# 阿里通义千问
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ---- 检索 / 向量后端 ----
# embedding 后端：local（离线零依赖）/ st（sentence-transformers，需模型权重）
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=

# ---- 语音入口（可选）----
# mock（离线）/ funasr（需 funasr + modelscope 与模型权重）
ASR_BACKEND=mock

# ---- 审批流对接 OA（可选）----
# mock（内存演示）/ mcp（通过 MCP 协议对接真实 OA server）
OA_BACKEND=mock
MCP_OA_SERVER=

# ---- 服务 ----
PORT=8000
CORS_ORIGINS=*
