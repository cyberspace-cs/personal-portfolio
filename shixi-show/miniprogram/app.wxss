page {
  background: #F5F6FA;
  font-family: -apple-system, "PingFang SC", sans-serif;
  color: #1f1f1f;
}
.container { padding: 24rpx; }
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.06);
}
.primary { color: #6C5CE7; }
.muted { color: #9AA0A6; font-size: 24rpx; }
