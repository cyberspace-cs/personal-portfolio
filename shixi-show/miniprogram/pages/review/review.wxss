.fld { border-bottom: 1rpx solid #eee; padding: 16rpx 0; font-size: 28rpx; }
.dim { display: flex; justify-content: space-between; align-items: center; padding: 10rpx 0; }
.dim-label { font-size: 28rpx; }
.stars .star { font-size: 40rpx; color: #ddd; margin-left: 8rpx; }
.stars .star.on { color: #FD79A8; }
.sec-title { font-weight: 700; display: block; margin-bottom: 12rpx; }
.stamps { display: flex; flex-wrap: wrap; gap: 12rpx; }
.stamp { font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 30rpx; background: #f0f0f0; color: #666; }
.stamp.on { background: #6C5CE7; color: #fff; }
.ta { width: 100%; height: 160rpx; font-size: 28rpx; }
.submit { background: #6C5CE7; color: #fff; border-radius: 16rpx; margin-top: 12rpx; }
