<view class="container">
  <view class="card">
    <input class="fld" placeholder="公司名称" value="{{companyName}}" bindinput="onCompany" />
    <input class="fld" placeholder="部门" value="{{dept}}" bindinput="onDept" />
    <input class="fld" placeholder="岗位" value="{{role}}" bindinput="onRole" />
  </view>

  <view class="card">
    <view class="dim" wx:for="{{dims}}" wx:key="key">
      <text class="dim-label">{{item.label}}</text>
      <view class="stars">
        <text wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:for-index="si" wx:key="*this"
              class="star {{s <= item.val ? 'on' : ''}}"
              data-i="{{index}}" data-v="{{s}}" bindtap="setScore">★</text>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="sec-title">盖章</text>
    <view class="stamps">
      <text wx:for="{{stamps}}" wx:key="*this"
            class="stamp {{picked.includes(item) ? 'on' : ''}}"
            data-s="{{item}}" bindtap="toggleStamp">{{item}}</text>
    </view>
  </view>

  <view class="card">
    <textarea class="ta" placeholder="说说你的真实感受…" value="{{content}}" bindinput="onContent" maxlength="500" />
  </view>

  <button class="submit" bindtap="submit">提交点评</button>
</view>
