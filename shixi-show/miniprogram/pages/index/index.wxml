<view class="container">
  <view class="hero">
    <text class="hero-title">实习 Show</text>
    <text class="hero-sub">真实实习点评 · 避雷避坑</text>
  </view>

  <view class="card company" wx:for="{{list}}" wx:key="id" bindtap="goCompany" data-id="{{item.id}}">
    <view class="rank">{{item.rank}}</view>
    <company-logo name="{{item.name}}" logo="{{item.logo}}" size="96"></company-logo>
    <view class="info">
      <view class="name-row">
        <text class="name">{{item.name}}</text>
        <text class="stamp" wx:if="{{item.stamp}}">{{item.stamp}}</text>
      </view>
      <view class="tags">
        <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
      </view>
      <view class="meta">
        <text class="score">★ {{item.avgScore}}</text>
        <text class="muted">{{item.reviewCount}} 条点评</text>
        <text class="fire" wx:if="{{item.hot}}">🔥</text>
      </view>
    </view>
  </view>
</view>
