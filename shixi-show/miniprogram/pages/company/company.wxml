<view class="container" wx:if="{{company}}">
  <view class="card head">
    <company-logo name="{{company.name}}" logo="{{company.logo}}" size="120"></company-logo>
    <view class="h-info">
      <text class="h-name">{{company.name}}</text>
      <text class="muted">{{company.industry}}</text>
      <text class="score">★ {{company.avgScore}} · {{company.reviewCount}} 条点评</text>
    </view>
  </view>

  <button class="primary-btn" bindtap="goReview">写点评</button>

  <view class="card rv" wx:for="{{reviews}}" wx:key="id">
    <view class="rv-head">
      <text class="rv-dept">{{item.dept}} · {{item.role}}</text>
      <text class="rv-stamp" wx:if="{{item.stamps.length}}">{{item.stamps[0]}}</text>
    </view>
    <view class="rv-scores muted">导师{{item.scores.mentor}} 成长{{item.scores.growth}} 转正{{item.scores.转正}} 薪资{{item.scores.薪资}} 平衡{{item.scores.wlb}}</view>
    <text class="rv-content">{{item.content}}</text>
  </view>

  <view wx:if="{{reviews.length === 0}}" class="muted empty">暂无点评，来做第一个吧～</view>
</view>
