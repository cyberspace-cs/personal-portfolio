<view class="container">
  <view class="search-bar">
    <input class="input" placeholder="搜公司 / 行业" value="{{q}}" bindinput="onInput" confirm-type="search" bindconfirm="onSearch" />
    <button class="btn" size="mini" bindtap="onSearch">搜索</button>
  </view>

  <view class="card" wx:for="{{results}}" wx:key="id" bindtap="goCompany" data-id="{{item.id}}">
    <text class="name">{{item.name}}</text>
    <text class="muted">{{item.industry}} · {{item.reviewCount}} 条点评</text>
  </view>

  <view wx:if="{{q && results.length === 0}}" class="muted empty">没有找到匹配的公司</view>
</view>
