<view class="container">
  <view class="card me">
    <text class="avatar">🙂</text>
    <text class="me-name">实习er</text>
  </view>

  <view class="card" wx:for="{{reviews}}" wx:key="id">
    <view class="rv-head">
      <text>{{item.companyName}} · {{item.dept}}</text>
      <text class="status">{{item.statusText}}</text>
    </view>
    <text class="muted">{{item.content}}</text>
  </view>

  <view wx:if="{{reviews.length === 0}}" class="muted empty">还没有点评记录</view>
</view>
